<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_navy"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Logo / Brand Indicator -->
    <LinearLayout
        android:id="@+id/btn_open_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5LB"
            android:textColor="#38bdf8"
            android:textStyle="bold"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:background="#334155"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txt_feed_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ULTIME"
            android:textColor="#94a3b8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />
    </LinearLayout>

    <!-- ViewFlipper per scorrimento automatico delle notizie senza blocco da focus -->
    <ViewFlipper
        android:id="@+id/view_flipper_news"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:flipInterval="4500"
        android:autoStart="true"
        android:inAnimation="@android:anim/slide_in_left"
        android:outAnimation="@android:anim/slide_out_right">

        <!-- Elemento Notizia 1 -->
        <LinearLayout
            android:id="@+id/item_news_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txt_news_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Caricamento ultime notizie 5LB..."
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Elemento Notizia 2 -->
        <LinearLayout
            android:id="@+id/item_news_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txt_news_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aggiornamento in corso..."
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Elemento Notizia 3 -->
        <LinearLayout
            android:id="@+id/item_news_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/txt_news_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5LB Magazine — Notizie revisionate"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

    </ViewFlipper>

    <!-- Pulsante Opzioni / Refresh -->
    <ImageButton
        android:id="@+id/btn_widget_settings"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_settings_gear"
        android:tint="#94a3b8"
        android:contentDescription="Opzioni widget"
        android:layout_marginStart="4dp" />

</LinearLayout>
